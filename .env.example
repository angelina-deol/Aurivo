# --- App ---
ENV=development
DEBUG=true

# --- Auth ---
JWT_SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- OAuth (Phase 1 skeleton only; fill in when wiring up real providers) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Database ---
DATABASE_URL=postgresql+psycopg2://aurivo:aurivo@postgres:5432/aurivo

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# --- Object storage (Phase 2+) ---
S3_ENDPOINT_URL=
S3_BUCKET=aurivo-audio
S3_ACCESS_KEY=
S3_SECRET_KEY=
